# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data (downloaded dataset + processed) — dir kept via .gitkeep
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models (regenerated by training)
models/
*.joblib
*.pkl

# Generated Pages report
reports/site/

# IDE / editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Lokalny indeks CodeGraph (graf kodu per maszyna, odbudowywalny przez `codegraph init`)
.codegraph/
# Added by code-review-graph
.code-review-graph/

# Packaging output. `pip install .` leaves a full copy of the package here; committing it
# would ship a stale mirror of the source alongside the real one.
build/
dist/
