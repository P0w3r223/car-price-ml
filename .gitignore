# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data (downloaded dataset + processed) — dir kept via .gitkeep
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Trained models (regenerated by training)
models/
*.joblib
*.pkl

# Generated Pages report
reports/site/

# IDE / editor
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Lokalny indeks CodeGraph (graf kodu per maszyna, odbudowywalny przez `codegraph init`)
.codegraph/
# Added by code-review-graph
.code-review-graph/

# Packaging output. `pip install .` leaves a full copy of the package here; committing it
# would ship a stale mirror of the source alongside the real one.
build/
dist/

# Claude Code, per machine. Not `.claude/` wholesale: `settings.json` is reviewable
# configuration and belongs to whoever checks this repository out, while the paths below
# never do. Left untracked and unignored, the first permission grant on any other checkout
# makes `git status` report a change that is not one — a standing false finding in the one
# instrument whose whole value is that a finding means something.
.claude/sessions/
.claude/settings.local.json
